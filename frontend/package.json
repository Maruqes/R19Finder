{
  "name": "r19finder-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test": "node --test tests/*.js",
